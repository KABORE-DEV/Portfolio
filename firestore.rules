rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper : vérifie que l'utilisateur est connecté ET qu'il s'agit bien de Frank
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "kabore.dev@gmail.com";
    }

    // Profil (document unique "main")
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projets
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Compétences (skills)
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services / Expertises
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Parcours : Éducation & Expérience
    match /education/{eduId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experience/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certifications
    match /certifications/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sécurité par défaut : interdire tout le reste
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
